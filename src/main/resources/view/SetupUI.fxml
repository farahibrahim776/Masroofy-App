<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="700" prefWidth="400"
           style="-fx-background-color: #f5f7fa;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.masroofy_app.view.SetupUI">

    <!-- Setup Form Card -->
    <VBox spacing="20" alignment="CENTER" maxWidth="340" maxHeight="560"
          style="-fx-background-color: white; 
                 -fx-background-radius: 20px; 
                 -fx-padding: 40px 30px; 
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 5);">

        <!-- Header Icon -->
        <Label text="💰" style="-fx-font-size: 48px;"/>

        <!-- Header Text -->
        <VBox alignment="CENTER" spacing="5" style="-fx-padding: 0 0 15px 0;">
            <Label text="Set Your Budget" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Define your allowance and cycle dates." style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </VBox>

        <!-- Amount Input -->
        <VBox spacing="8" alignment="TOP_LEFT" maxWidth="Infinity">
            <Label text="Total Allowance (EGP)" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <TextField fx:id="amountField" promptText="e.g. 5000"
                       style="-fx-font-size: 16px; 
                              -fx-background-color: #f8f9fa; 
                              -fx-background-radius: 8px; 
                              -fx-padding: 12px; 
                              -fx-border-color: #e0e0e0; 
                              -fx-border-radius: 8px;"/>
        </VBox>

        <!-- Dates Input (Side by Side) -->
        <HBox spacing="15" maxWidth="Infinity">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="Start Date" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <DatePicker fx:id="startDate" maxWidth="Infinity"
                            style="-fx-font-size: 14px; -fx-background-color: #f8f9fa;"/>
            </VBox>

            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="End Date" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <DatePicker fx:id="endDate" maxWidth="Infinity"
                            style="-fx-font-size: 14px; -fx-background-color: #f8f9fa;"/>
            </VBox>
        </HBox>

        <Label fx:id="errorLabel" text="" visible="false" wrapText="true" maxWidth="Infinity"
               style="-fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-font-weight: bold;"/>

        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS" minHeight="10"/>

        <!-- Primary Action Button -->
        <Button text="Start Cycle" onAction="#handleStart" maxWidth="Infinity"
                style="-fx-background-color: #27ae60; 
                       -fx-text-fill: white; 
                       -fx-font-size: 18px; 
                       -fx-font-weight: bold; 
                       -fx-background-radius: 25px; 
                       -fx-padding: 12px; 
                       -fx-cursor: hand; 
                       -fx-effect: dropshadow(gaussian, rgba(39, 174, 96, 0.4), 10, 0, 0, 3);"/>
    </VBox>

</StackPane>

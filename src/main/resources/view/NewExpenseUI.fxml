<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Controller: NewExpenseUI (com.example.masroofy_app.view.NewExpenseUI)
    @FXML fields required:  rootBox, amountField, titleField, errorLabel,
                            cancelBtn, confirmBtn,
                            foodBtn, transportBtn, shoppingBtn,
                            billsBtn, entertainmentBtn, otherBtn
    All wired via setOnAction in initialize() — no onAction attributes needed on buttons
    except the ones explicitly listed below.

    FIXES:
    - Added fx:id="titleField"   — required by NewExpenseUI.java and DatabaseHelper.insertExpense()
    - Added fx:id="errorLabel"   — controller shows validation errors here instead of console
    - Added fx:id="billsBtn"     — category id=4, was missing from original UI
    - Added fx:id="entertainmentBtn" — category id=5, was missing from original UI
    - Removed addCategoryBtn     — was only wired to System.out.println, dead UI element
-->
<AnchorPane prefHeight="700" prefWidth="400"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.masroofy_app.view.NewExpenseUI"
            style="-fx-background-color: #f5f7fa;">

    <children>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    AnchorPane.topAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    AnchorPane.bottomAnchor="0">
            <content>
                <VBox fx:id="rootBox" spacing="25" alignment="TOP_CENTER"
                      style="-fx-padding: 30px 20px;">

                    <!-- Header -->
                    <Label text="New Expense"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <!-- Title Input Card -->
                    <!-- FIX: fx:id="titleField" added — NewExpenseUI.java reads this to pass a
                         meaningful title to DatabaseHelper.insertExpense(). Without it, the title
                         was always "Expense" regardless of what the user typed. -->
                    <VBox alignment="CENTER_LEFT" spacing="10"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15px;
                                 -fx-padding: 20px 25px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Label text="Expense Title"
                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                        <TextField fx:id="titleField" promptText="e.g. Lunch, Uber, Netflix..."
                                   style="-fx-font-size: 16px;
                                          -fx-background-color: #f1f2f6;
                                          -fx-background-radius: 10px;
                                          -fx-padding: 10px 14px;
                                          -fx-text-fill: #2c3e50;
                                          -fx-prompt-text-fill: #bdc3c7;"/>
                    </VBox>

                    <!-- Amount Input Card -->
                    <VBox alignment="CENTER" spacing="15"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15px;
                                 -fx-padding: 30px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Label text="Enter Amount (EGP)"
                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                        <TextField fx:id="amountField" promptText="0.00" alignment="CENTER"
                                   style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #27ae60;
                                          -fx-background-color: transparent; -fx-border-color: #bdc3c7;
                                          -fx-border-width: 0 0 2 0; -fx-padding: 5px;"/>
                    </VBox>

                    <!-- Category Selection Card -->
                    <!-- FIX: billsBtn (id=4) and entertainmentBtn (id=5) added — these categories
                         existed in DB and CategoryUtils but were missing from the UI entirely,
                         making them un-selectable. addCategoryBtn removed (was dead code). -->
                    <VBox alignment="CENTER" spacing="15"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15px;
                                 -fx-padding: 20px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Label text="Select Category"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <FlowPane alignment="CENTER" hgap="10" vgap="10" prefWrapLength="340">
                            <Button fx:id="foodBtn" text="🍕 Food"
                                    style="-fx-background-color: #f1f2f6; -fx-text-fill: #2c3e50; -fx-background-radius: 20px; -fx-padding: 8px 15px; -fx-cursor: hand;"/>
                            <Button fx:id="transportBtn" text="🚕 Transport"
                                    style="-fx-background-color: #f1f2f6; -fx-text-fill: #2c3e50; -fx-background-radius: 20px; -fx-padding: 8px 15px; -fx-cursor: hand;"/>
                            <Button fx:id="shoppingBtn" text="🛍️ Shopping"
                                    style="-fx-background-color: #f1f2f6; -fx-text-fill: #2c3e50; -fx-background-radius: 20px; -fx-padding: 8px 15px; -fx-cursor: hand;"/>
                            <Button fx:id="billsBtn" text="🧾 Bills"
                                    style="-fx-background-color: #f1f2f6; -fx-text-fill: #2c3e50; -fx-background-radius: 20px; -fx-padding: 8px 15px; -fx-cursor: hand;"/>
                            <Button fx:id="entertainmentBtn" text="🎬 Entertainment"
                                    style="-fx-background-color: #f1f2f6; -fx-text-fill: #2c3e50; -fx-background-radius: 20px; -fx-padding: 8px 15px; -fx-cursor: hand;"/>
                            <Button fx:id="otherBtn" text="📦 Other"
                                    style="-fx-background-color: #f1f2f6; -fx-text-fill: #2c3e50; -fx-background-radius: 20px; -fx-padding: 8px 15px; -fx-cursor: hand;"/>
                        </FlowPane>
                    </VBox>

                    <!-- FIX: fx:id="errorLabel" added — controller calls showError() which sets
                         this label's text and makes it visible instead of printing to console. -->
                    <Label fx:id="errorLabel" text="" visible="false" wrapText="true"
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-font-weight: bold;"/>

                    <!-- Action Buttons -->
                    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10px 0 30px 0;">
                        <Button fx:id="cancelBtn" text="Cancel" prefWidth="120"
                                style="-fx-background-color: #ecf0f1; -fx-text-fill: #7f8c8d; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-padding: 12px; -fx-cursor: hand;"/>
                        <Button fx:id="confirmBtn" text="Save Expense" prefWidth="180"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 25px; -fx-padding: 12px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(39, 174, 96, 0.4), 10, 0, 0, 3);"/>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700" prefWidth="400"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.masroofy_app.Controller.StatsController"
            style="-fx-background-color:#f5f7fa;">

    <children>
        <!-- Scrollable Main Content -->
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    AnchorPane.topAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    AnchorPane.bottomAnchor="60">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 20px;">

                    <!-- App Header -->
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Statistics" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    </HBox>

                    <VBox alignment="CENTER" spacing="5"
                          style="-fx-background-color: linear-gradient(to bottom right, #3498db, #2980b9);
                                 -fx-background-radius: 15px;
                                 -fx-padding: 25px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 5);">
                        <Label text="Total Spent This Cycle" style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
                        <Label fx:id="totalLabel" text="0.00 EGP" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    </VBox>

                    <!-- Chart Card -->
                    <VBox spacing="15" alignment="CENTER"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15px;
                                 -fx-padding: 20px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">

                        <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                            <Label text="Category Breakdown" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        </HBox>

                        <PieChart fx:id="pieChart" prefHeight="250" legendSide="BOTTOM"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

        <HBox alignment="CENTER" spacing="35"
              AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              style="-fx-background-color: white;
                     -fx-padding: 15px;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, -2);">

            <Button text="Dashboard" onAction="#handleDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button text="History" onAction="#handleHistory"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <!-- Stats is the active screen — highlighted -->
            <Button text="Settings" onAction="#handleSettings"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

        </HBox>

    </children>
</AnchorPane>

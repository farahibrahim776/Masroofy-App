<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700" prefWidth="400"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.masroofy_app.view.SettingsUI"
            style="-fx-background-color: #f5f7fa;">

    <children>
        <VBox AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

            <!-- FIX #9: Replace invisible-button centering hack with a proper StackPane header.
                 Back button is left-aligned inside its own HBox layer; title is independently centered. -->
            <StackPane style="-fx-padding: 20px 20px 10px 20px;">
                <HBox alignment="CENTER_LEFT">
                    <Button text="← Back" onAction="#goBack"
                            style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
                </HBox>
                <Label text="Settings" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                       StackPane.alignment="CENTER"/>
            </StackPane>

            <!-- Scrollable Settings List -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <content>
                    <VBox spacing="25" alignment="TOP_CENTER" style="-fx-padding: 20px;">

                        <!-- Card 1: Application Settings -->
                        <VBox spacing="10"
                              style="-fx-background-color: white; 
                                     -fx-background-radius: 15px; 
                                     -fx-padding: 20px; 
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">

                            <Label text="APPLICATION" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;"/>

                            <!-- FIX #2: onAction added — was missing, button did nothing -->
                            <Button text="Manage Categories" onAction="#handleManageCategories"
                                    maxWidth="Infinity" alignment="BASELINE_LEFT"
                                    style="-fx-background-color: #f8f9fa; -fx-text-fill: #2c3e50; -fx-font-size: 15px; -fx-padding: 12px 15px; -fx-background-radius: 10px; -fx-cursor: hand;"/>

                            <!-- FIX #2: onAction added — was missing, button did nothing -->
                            <Button text="Reset Cycle" onAction="#handleResetCycle"
                                    maxWidth="Infinity" alignment="BASELINE_LEFT"
                                    style="-fx-background-color: #f8f9fa; -fx-text-fill: #2c3e50; -fx-font-size: 15px; -fx-padding: 12px 15px; -fx-background-radius: 10px; -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Card 2: Security and Privacy -->
                        <VBox spacing="10"
                              style="-fx-background-color: white; 
                                     -fx-background-radius: 15px; 
                                     -fx-padding: 20px; 
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">

                            <Label text="SECURITY &amp; PRIVACY" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;"/>

                            <HBox alignment="CENTER_LEFT" spacing="10"
                                  style="-fx-background-color: #f8f9fa; -fx-padding: 12px 15px; -fx-background-radius: 10px;">
                                <Label text="Enable Privacy Lock" style="-fx-text-fill: #2c3e50; -fx-font-size: 15px;" HBox.hgrow="ALWAYS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <CheckBox fx:id="privacyCheck" style="-fx-cursor: hand;"/>
                            </HBox>

                            <!-- FIX #2: onAction added — was missing, button did nothing -->
                            <Button text="Change PIN" onAction="#handleChangePIN"
                                    maxWidth="Infinity" alignment="BASELINE_LEFT"
                                    style="-fx-background-color: #f8f9fa; -fx-text-fill: #2c3e50; -fx-font-size: 15px; -fx-padding: 12px 15px; -fx-background-radius: 10px; -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Card 3: About & Danger Zone -->
                        <VBox spacing="10"
                              style="-fx-background-color: white; 
                                     -fx-background-radius: 15px; 
                                     -fx-padding: 20px; 
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">

                            <Label text="ABOUT &amp; DATA" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;"/>

                            <VBox spacing="5" style="-fx-padding: 5px 15px 15px 15px;">
                                <Label text="Version: 1.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                                <Label text="Storage: SQLite Local" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                            </VBox>

                            <!-- FIX #2: onAction added — was missing, button did nothing (especially dangerous for Reset) -->
                            <Button text="Reset Database" onAction="#handleResetDatabase"
                                    maxWidth="Infinity" alignment="CENTER"
                                    style="-fx-background-color: #ffebee; -fx-text-fill: #e74c3c; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 12px; -fx-background-radius: 10px; -fx-cursor: hand;"/>
                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </children>

</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="700" prefWidth="400"
           style="-fx-background-color: #f5f7fa;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.masroofy_app.Controller.PinLoginController">

    <!-- Login Card -->
    <VBox spacing="25" alignment="CENTER" maxWidth="320"
          style="-fx-background-color: white;
                 -fx-background-radius: 20px;
                 -fx-padding: 40px 30px;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 5);">

        <!-- Lock Icon -->
        <Label text="🔒" style="-fx-font-size: 48px;"/>

        <!-- Headers -->
        <VBox alignment="CENTER" spacing="5">
            <Label text="Welcome Back" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Enter your PIN to unlock" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </VBox>

        <PasswordField fx:id="pinField" alignment="CENTER" promptText="••••"
                       style="-fx-font-size: 32px;
                              -fx-background-color: #f1f2f6;
                              -fx-background-radius: 12px;
                              -fx-padding: 15px;
                              -fx-text-fill: #2c3e50;
                              -fx-prompt-text-fill: #bdc3c7;"/>

        <Label fx:id="errorLabel" text="" visible="false" wrapText="true"
               style="-fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-font-weight: bold;"/>

        <!-- Unlock Button -->
        <Button text="Unlock" onAction="#unlock" maxWidth="Infinity"
                style="-fx-background-color: #27ae60;
                       -fx-text-fill: white;
                       -fx-font-size: 18px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 25px;
                       -fx-padding: 12px;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(39, 174, 96, 0.4), 10, 0, 0, 3);"/>
    </VBox>
</StackPane>

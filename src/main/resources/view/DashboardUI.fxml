<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="600" prefWidth="350"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.masroofy_app.Controller.DashboardController"
            style="-fx-background-color:#f5f7fa;">

    <children>

        <!-- Main Container -->
        <VBox alignment="TOP_CENTER"
              spacing="20"
              AnchorPane.topAnchor="20"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0">

            <!-- ===== Circle ===== -->
            <StackPane prefWidth="200" prefHeight="200">

                <Circle radius="100" fill="transparent"
                        stroke="#2c3e50" strokeWidth="2"/>

                <Circle radius="75" fill="transparent"
                        stroke="#bdc3c7" strokeWidth="2"/>

                <VBox alignment="CENTER">
                    <Label text="Today's Limit"
                           style="-fx-text-fill:gray; -fx-font-size:14px;"/>

                    <Label fx:id="dailyLimitLabel"
                           text="0 EGP"
                           style="-fx-text-fill:#27ae60; -fx-font-size:20px; -fx-font-weight:bold;"/>
                </VBox>

            </StackPane>

            <!-- Button -->
            <Button text="Log Expense"
                    prefWidth="140"
                    style="-fx-background-radius:10;
                           -fx-background-color:white;
                           -fx-border-color:#2c3e50;
                           -fx-border-radius:10;" />

            <!-- Pie Chart -->
            <PieChart fx:id="pieChart"
                      prefWidth="280"
                      prefHeight="200"
                      legendSide="RIGHT" />

        </VBox>

        <!-- Bottom Nav -->
        <HBox alignment="CENTER"
              spacing="20"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0"
              style="-fx-background-color:white; -fx-padding:10;">

            <Button text="Log Expense"
                    onAction="#handleLogExpense"
                    prefWidth="140" />

            <Button text="Dashboard"
                    onAction="#goToDashboard" />

            <Button text="History"
                    onAction="#goToHistory" />

            <Button text="Stats"
                    onAction="#goToStats" />

            <Button text="Settings"
                    onAction="#goToSettings" />

        </HBox>

    </children>
</AnchorPane>
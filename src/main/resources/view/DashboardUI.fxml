<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.DashboardUI">

    <children>

        <!-- Title -->
        <Label layoutX="320" layoutY="20"
               text="Masroofy Dashboard"
               style="-fx-font-size:26px; -fx-font-weight:bold;" />

        <!-- Daily Limit -->
        <Label layoutX="360" layoutY="80"
               text="Safe Daily Limit"
               style="-fx-font-size:16px;" />

        <Label fx:id="dailyLimitLabel"
               layoutX="370" layoutY="110"
               text="0 EGP"
               style="-fx-font-size:32px; -fx-text-fill:green;" />

        <!-- Info Cards -->
        <VBox layoutX="80" layoutY="190" spacing="15">

            <Label text="Remaining Balance:" />
            <Label fx:id="balanceLabel"
                   text="0 EGP"
                   style="-fx-font-size:20px;" />

            <Label text="Days Left:" />
            <Label fx:id="daysLabel"
                   text="0"
                   style="-fx-font-size:20px;" />

        </VBox>

        <!-- Pie Chart -->
        <PieChart fx:id="pieChart"
                  layoutX="430"
                  layoutY="190"
                  prefHeight="280"
                  prefWidth="350" />

        <!-- Bottom Buttons -->
        <HBox layoutX="250" layoutY="530" spacing="20">

            <Button text="Add Expense" />
            <Button text="History" />
            <Button text="Settings" />

        </HBox>

    </children>

</AnchorPane>
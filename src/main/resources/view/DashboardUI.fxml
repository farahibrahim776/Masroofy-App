<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700" prefWidth="400"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.masroofy_app.Controller.DashboardController"
            style="-fx-background-color:#f5f7fa;">

    <children>
        <!-- Scrollable Main Content -->
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    AnchorPane.topAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    AnchorPane.bottomAnchor="60">
            <content>
                <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 20px;">

                    <!-- App Header -->
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Overview"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    </HBox>

                    <!-- Hero Card: Total Remaining Balance -->
                    <VBox alignment="CENTER" spacing="5"
                          style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #34495e);
                                 -fx-background-radius: 15px;
                                 -fx-padding: 25px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 5);">
                        <Label text="Total Remaining Balance"
                               style="-fx-text-fill: #bdc3c7; -fx-font-size: 14px;"/>
                        <Label fx:id="balanceLabel" text="0.00 EGP"
                               style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    </VBox>

                    <!-- Primary Action Button -->
                    <Button text="+ Log Expense" onAction="#handleLogExpense" prefWidth="250"
                            style="-fx-background-color: #27ae60;
                                   -fx-text-fill: white;
                                   -fx-font-size: 16px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 25px;
                                   -fx-padding: 12px;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(39, 174, 96, 0.4), 10, 0, 0, 3);"/>

                    <!-- Daily Limit + Days Left Card -->
                    <VBox alignment="CENTER" spacing="10"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15px;
                                 -fx-padding: 25px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Label text="Today's Limit"
                               style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                        <Label fx:id="dailyLimitLabel" text="0.00 EGP"
                               style="-fx-text-fill: #2c3e50; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label fx:id="daysLabel" text="0 Days Left"
                               style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;"/>
                    </VBox>

                    <!-- Spending Breakdown (Pie Chart) -->
                    <VBox spacing="10"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 15px;
                                 -fx-padding: 15px;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Label text="Spending Breakdown"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <PieChart fx:id="pieChart" prefHeight="220" legendSide="BOTTOM"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

        <!-- Bottom Navigation Bar -->
        <HBox alignment="CENTER" spacing="40"
              AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              style="-fx-background-color: white;
                     -fx-padding: 15px;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, -2);">

            <Button text="History" onAction="#goToHistory"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button text="Stats" onAction="#goToStats"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button text="Settings" onAction="#goToSettings"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

        </HBox>

    </children>
</AnchorPane>

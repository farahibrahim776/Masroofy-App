<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.masroofy_app.view.HistoryUI"
            prefWidth="600" prefHeight="500"
            style="-fx-background-color: #f5f5f5;">

    <VBox spacing="20" layoutX="50" layoutY="30" prefWidth="500">

        <Label text="Expense History"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <!-- TODAY -->
        <Label text="Today"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <VBox fx:id="todayBox" spacing="10"/>

        <!-- YESTERDAY -->
        <Label text="Yesterday"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <VBox fx:id="yesterdayBox" spacing="10"/>

    </VBox>

</AnchorPane>
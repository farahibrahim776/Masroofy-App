<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Controller: HistoryUI (com.example.masroofy_app.view.HistoryUI)
    @FXML fields required:  todayBox, yesterdayBox, olderBox
    @FXML methods required: goToDashboard, goToStats, openSettings

    FIX: Added fx:id="olderBox" — was completely missing from the original FXML.
    HistoryUI.java buckets expenses into today / yesterday / older, but without
    olderBox in the FXML the controller logged a warning and silently dropped
    all expenses older than yesterday from the UI.
-->
<AnchorPane prefHeight="700" prefWidth="400"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.masroofy_app.view.HistoryUI"
            style="-fx-background-color: #f5f7fa;">

    <children>
        <!-- Scrollable Main Content -->
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    AnchorPane.topAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    AnchorPane.bottomAnchor="60">
            <content>
                <VBox spacing="25" alignment="TOP_CENTER" style="-fx-padding: 25px;">

                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Expense History"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    </HBox>

                    <!-- Today Section -->
                    <VBox spacing="10" alignment="TOP_LEFT">
                        <Label text="TODAY"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;"/>
                        <VBox fx:id="todayBox" spacing="12"/>
                    </VBox>

                    <!-- Yesterday Section -->
                    <VBox spacing="10" alignment="TOP_LEFT">
                        <Label text="YESTERDAY"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;"/>
                        <VBox fx:id="yesterdayBox" spacing="12"/>
                    </VBox>

                    <!-- FIX: Added "OLDER" section — fx:id="olderBox" was missing entirely.
                         HistoryUI.java correctly calculates which expenses belong here but
                         had nowhere to put them, causing them to be silently dropped. -->
                    <VBox spacing="10" alignment="TOP_LEFT">
                        <Label text="OLDER"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #95a5a6;"/>
                        <VBox fx:id="olderBox" spacing="12"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

        <!-- Bottom Navigation Bar -->
        <HBox alignment="CENTER" spacing="35"
              AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              style="-fx-background-color: white;
                     -fx-padding: 15px;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, -2);">

            <Button text="Dashboard" onAction="#goToDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Button text="Stats" onAction="#goToStats"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <!-- FIX: onAction="#openSettings" — matches HistoryUI.java's method name exactly.
                 The method is public void openSettings() not goToSettings(). -->
            <Button text="Settings" onAction="#openSettings"
                    style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

        </HBox>

    </children>
</AnchorPane>
